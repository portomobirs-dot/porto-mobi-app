rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function adminPath(uid) { return /databases/$(database)/documents/administradores/$(uid); }
    function clientPath(uid) { return /databases/$(database)/documents/clientes/$(uid); }
    function driverPath(uid) { return /databases/$(database)/documents/motoristas/$(uid); }
    function counterPath(kind) { return /databases/$(database)/documents/contadores/$(kind); }
    function tripPath(id) { return /databases/$(database)/documents/reservas/$(id); }
    function isAdmin() {
      return signedIn() && (request.auth.token.get('admin', false) == true || (exists(adminPath(me())) && get(adminPath(me())).data.ativo == true));
    }
    function activeDriver() {
      return signedIn() && exists(driverPath(me())) && (get(driverPath(me())).data.get('situacao', '') == 'ativo' || get(driverPath(me())).data.get('aprovado', false) == true);
    }
    function code(prefix, n) {
      return prefix + '-' + (prefix == 'PMM' ? (n < 10 ? '00' : n < 100 ? '0' : '') : (n < 10 ? '000' : n < 100 ? '00' : n < 1000 ? '0' : '')) + string(n);
    }
    function nextCount(kind, n) {
      return n is int && n >= 1 &&
        ((!exists(counterPath(kind)) && n == 1) ||
         (exists(counterPath(kind)) && get(counterPath(kind)).data.ultimo + 1 == n));
    }
    function clientCounterWrite() {
      return signedIn() && !isAdmin() &&
        request.resource.data.keys().hasAll(['ultimo','ultimoUid']) &&
        request.resource.data.keys().hasOnly(['ultimo','ultimoUid']) &&
        request.resource.data.ultimoUid == me() &&
        request.resource.data.ultimo is int &&
        request.resource.data.ultimo >= 1 && request.resource.data.ultimo <= 40 &&
        !exists(clientPath(me())) &&
        getAfter(clientPath(me())).data.numeroCliente == request.resource.data.ultimo &&
        getAfter(clientPath(me())).data.uid == me();
    }
    function reservationCounterWrite() {
      return signedIn() &&
        request.resource.data.keys().hasAll(['ultimo','ultimoReservaId','ultimoClienteUid']) &&
        request.resource.data.keys().hasOnly(['ultimo','ultimoReservaId','ultimoClienteUid']) &&
        request.resource.data.ultimoClienteUid == me() &&
        request.resource.data.ultimo is int &&
        request.resource.data.ultimo >= 1 && request.resource.data.ultimo <= 9999 &&
        request.resource.data.ultimoReservaId is string &&
        request.resource.data.ultimoReservaId.size() >= 8 &&
        request.resource.data.ultimoReservaId.size() <= 30 &&
        !exists(tripPath(request.resource.data.ultimoReservaId)) &&
        getAfter(tripPath(request.resource.data.ultimoReservaId)).data.numeroReserva == request.resource.data.ultimo &&
        getAfter(tripPath(request.resource.data.ultimoReservaId)).data.clienteUid == me();
    }
    function driverCounterWrite() {
      return isAdmin() &&
        request.resource.data.keys().hasAll(['ultimo','ultimoUid']) &&
        request.resource.data.keys().hasOnly(['ultimo','ultimoUid']) &&
        request.resource.data.ultimo is int &&
        request.resource.data.ultimo >= 1 && request.resource.data.ultimo <= 3 &&
        request.resource.data.ultimoUid is string &&
        get(driverPath(request.resource.data.ultimoUid)).data.situacao == 'pendente' &&
        getAfter(driverPath(request.resource.data.ultimoUid)).data.situacao == 'ativo' &&
        getAfter(driverPath(request.resource.data.ultimoUid)).data.numeroMotorista == request.resource.data.ultimo;
    }
    match /administradores/{uid} {
      // Primeiro documento criado exclusivamente no Console Firebase, nunca pelo aplicativo.
      allow get: if signedIn() && me() == uid;
      allow list, create, update, delete: if false;
    }
    match /contadores/{kind} {
      allow get: if signedIn() && (kind in ['clientes','reservas'] || isAdmin());
      allow list, delete: if false;
      allow create: if
        (kind == 'clientes' && clientCounterWrite() && request.resource.data.ultimo == 1) ||
        (kind == 'reservas' && reservationCounterWrite() && request.resource.data.ultimo == 1) ||
        (kind == 'motoristas' && driverCounterWrite() && request.resource.data.ultimo == 1);
      allow update: if
        (kind == 'clientes' && clientCounterWrite() && request.resource.data.ultimo == resource.data.ultimo + 1) ||
        (kind == 'reservas' && reservationCounterWrite() && request.resource.data.ultimo == resource.data.ultimo + 1) ||
        (kind == 'motoristas' && driverCounterWrite() && request.resource.data.ultimo == resource.data.ultimo + 1);
    }
    match /clientes/{uid} {
      allow get: if isAdmin() || (signedIn() && me() == uid);
      allow list: if isAdmin();
      allow create: if signedIn() && me() == uid && !isAdmin() &&
        request.resource.data.keys().hasAll(['uid','numeroCliente','codigoCliente','nomeCliente','telefoneCliente','email','dataCadastro']) &&
        request.resource.data.keys().hasOnly(['uid','numeroCliente','codigoCliente','nomeCliente','telefoneCliente','email','dataCadastro']) &&
        request.resource.data.uid == me() &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.numeroCliente is int &&
        request.resource.data.numeroCliente >= 1 && request.resource.data.numeroCliente <= 40 &&
        request.resource.data.codigoCliente == code('PMC',request.resource.data.numeroCliente) &&
        request.resource.data.nomeCliente is string &&
        request.resource.data.nomeCliente.size() >= 3 && request.resource.data.nomeCliente.size() <= 150 &&
        request.resource.data.telefoneCliente is string &&
        request.resource.data.telefoneCliente.size() >= 10 && request.resource.data.telefoneCliente.size() <= 20 &&
        request.resource.data.dataCadastro == request.time &&
        nextCount('clientes',request.resource.data.numeroCliente) &&
        getAfter(counterPath('clientes')).data.ultimo == request.resource.data.numeroCliente &&
        getAfter(counterPath('clientes')).data.ultimoUid == me();
      allow update, delete: if false;
    }
    match /motoristas/{uid} {
      allow get: if isAdmin() || (signedIn() && me() == uid);
      allow list: if isAdmin();
      allow create: if signedIn() && me() == uid && !isAdmin() &&
        request.resource.data.keys().hasAll(['uid','nomeMotorista','telefoneMotorista','email','veiculoModelo','veiculoPlaca','veiculoCor','situacao','numeroMotorista','codigoMotorista','dataCadastro']) &&
        request.resource.data.keys().hasOnly(['uid','nomeMotorista','telefoneMotorista','email','veiculoModelo','veiculoPlaca','veiculoCor','situacao','numeroMotorista','codigoMotorista','dataCadastro']) &&
        request.resource.data.uid == me() &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.situacao == 'pendente' &&
        request.resource.data.numeroMotorista == 0 && request.resource.data.codigoMotorista == '' &&
        request.resource.data.nomeMotorista is string && request.resource.data.nomeMotorista.size() >= 3 && request.resource.data.nomeMotorista.size() <= 150 &&
        request.resource.data.telefoneMotorista is string && request.resource.data.telefoneMotorista.size() >= 10 && request.resource.data.telefoneMotorista.size() <= 20 &&
        request.resource.data.veiculoModelo is string && request.resource.data.veiculoModelo.size() >= 2 && request.resource.data.veiculoModelo.size() <= 100 &&
        request.resource.data.veiculoCor is string && request.resource.data.veiculoCor.size() >= 2 && request.resource.data.veiculoCor.size() <= 50 &&
        request.resource.data.veiculoPlaca.matches('^[A-Z]{3}-[0-9][A-Z0-9][0-9]{2}$') &&
        request.resource.data.dataCadastro == request.time;
      // O motorista NUNCA pode se autoaprovar ou alterar seu proprio papel.
      allow update: if isAdmin() &&
        resource.data.situacao == 'pendente' && request.resource.data.situacao == 'ativo' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['situacao','numeroMotorista','codigoMotorista','dataAprovacao']) &&
        request.resource.data.numeroMotorista is int &&
        request.resource.data.numeroMotorista >= 1 && request.resource.data.numeroMotorista <= 3 &&
        request.resource.data.codigoMotorista == code('PMM',request.resource.data.numeroMotorista) &&
        request.resource.data.dataAprovacao == request.time &&
        nextCount('motoristas',request.resource.data.numeroMotorista) &&
        getAfter(counterPath('motoristas')).data.ultimo == request.resource.data.numeroMotorista &&
        getAfter(counterPath('motoristas')).data.ultimoUid == uid;
      allow delete: if false;
    }
    function clientTripCreate(id) {
      return signedIn() && exists(clientPath(me())) &&
        request.resource.data.keys().hasAll(['numeroReserva','codigoReserva','clienteUid','codigoCliente','nomeCliente','telefoneCliente','codigoMotorista','motoristaUid','localEmbarque','localDestino','dataViagem','dataSolicitacao','observacoes','statusReserva','valorViagem']) &&
        request.resource.data.keys().hasOnly(['numeroReserva','codigoReserva','clienteUid','codigoCliente','nomeCliente','telefoneCliente','codigoMotorista','motoristaUid','localEmbarque','localDestino','dataViagem','dataSolicitacao','observacoes','statusReserva','valorViagem']) &&
        request.resource.data.clienteUid == me() &&
        request.resource.data.codigoCliente == get(clientPath(me())).data.codigoCliente &&
        request.resource.data.nomeCliente == get(clientPath(me())).data.nomeCliente &&
        request.resource.data.telefoneCliente == get(clientPath(me())).data.telefoneCliente &&
        request.resource.data.numeroReserva is int &&
        request.resource.data.numeroReserva >= 1 && request.resource.data.numeroReserva <= 9999 &&
        request.resource.data.codigoReserva == code('PMR',request.resource.data.numeroReserva) &&
        request.resource.data.codigoMotorista == '' && request.resource.data.motoristaUid == '' &&
        request.resource.data.localEmbarque is string && request.resource.data.localEmbarque.size() >= 3 && request.resource.data.localEmbarque.size() <= 500 &&
        request.resource.data.localDestino is string && request.resource.data.localDestino.size() >= 3 && request.resource.data.localDestino.size() <= 500 &&
        request.resource.data.observacoes is string && request.resource.data.observacoes.size() <= 2000 &&
        request.resource.data.dataViagem is timestamp && request.resource.data.dataViagem > request.time &&
        request.resource.data.dataSolicitacao == request.time &&
        request.resource.data.statusReserva == 'pendente' && request.resource.data.valorViagem == 0 &&
        nextCount('reservas',request.resource.data.numeroReserva) &&
        getAfter(counterPath('reservas')).data.ultimo == request.resource.data.numeroReserva &&
        getAfter(counterPath('reservas')).data.ultimoReservaId == id &&
        getAfter(counterPath('reservas')).data.ultimoClienteUid == me();
    }
    function validAssignedDriver() {
      return request.resource.data.motoristaUid is string &&
        request.resource.data.motoristaUid.size() > 0 &&
        exists(driverPath(request.resource.data.motoristaUid)) &&
        (get(driverPath(request.resource.data.motoristaUid)).data.get('situacao', '') == 'ativo' ||
         get(driverPath(request.resource.data.motoristaUid)).data.get('aprovado', false) == true) &&
        get(driverPath(request.resource.data.motoristaUid)).data.codigoMotorista == request.resource.data.codigoMotorista;
    }
    function adminTripUpdate() {
      // Nesta versão, o painel só oferece ou recusa reservas pendentes.
      // Reservas recusadas/concluidas nunca podem ser reabertas pelo painel.
      return isAdmin() &&
        resource.data.statusReserva == 'pendente' &&
        resource.data.motoristaUid == '' && resource.data.codigoMotorista == '' &&
        request.resource.data.dataAtualizacao == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusReserva','motoristaUid','codigoMotorista','dataAtualizacao']) &&
        ((request.resource.data.statusReserva == 'oferecida' && validAssignedDriver()) ||
         (request.resource.data.statusReserva == 'recusada' &&
          request.resource.data.motoristaUid == '' && request.resource.data.codigoMotorista == ''));
    }
    function driverTripUpdate() {
      return activeDriver() && resource.data.motoristaUid == me() &&
        request.resource.data.dataAtualizacao == request.time &&
        ((resource.data.statusReserva == 'oferecida' &&
           request.resource.data.statusReserva == 'confirmada' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusReserva','dataAtualizacao'])) ||
         (resource.data.statusReserva == 'oferecida' &&
           request.resource.data.statusReserva == 'pendente' &&
           request.resource.data.motoristaUid == '' && request.resource.data.codigoMotorista == '' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusReserva','motoristaUid','codigoMotorista','dataAtualizacao'])) ||
         (resource.data.statusReserva == 'confirmada' &&
           request.resource.data.statusReserva == 'em_andamento' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusReserva','dataAtualizacao'])) ||
         (resource.data.statusReserva == 'em_andamento' &&
           request.resource.data.statusReserva == 'concluida' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusReserva','dataAtualizacao'])));
    }
    match /reservas/{id} {
      allow get, list: if isAdmin() ||
        (signedIn() && resource.data.clienteUid == me()) ||
        (signedIn() && resource.data.motoristaUid == me() && activeDriver());
      allow create: if clientTripCreate(id);
      allow update: if adminTripUpdate() || driverTripUpdate();
      allow delete: if false;
    }
    match /{other=**} { allow read, write: if false; }
  }
}
